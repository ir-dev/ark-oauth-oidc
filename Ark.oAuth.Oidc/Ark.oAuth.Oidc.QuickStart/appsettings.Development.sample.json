{
  // ---------------------------------------------------------------------------------------
  // Template for appsettings.Development.json: the local, gitignored file for this machine's
  // own values. Copy it, then replace the placeholder:
  //
  //   cp appsettings.Development.sample.json appsettings.Development.json
  //
  // Where a value comes from, first match wins:
  //
  //   1. environment variables          ark_oauth_server__Setup__AccessKey=…
  //   2. user secrets                   dotnet user-secrets set "ark_oauth_server:Setup:AccessKey" …
  //   3. ark-idp-data/settings.json     what the setup wizard wrote
  //   4. appsettings.Development.json   this file's copy, when ASPNETCORE_ENVIRONMENT=Development
  //   5. appsettings.json               committed, no secrets
  //
  // Nothing here is needed to run the wizard: `dotnet run` and open https://localhost:7300. These
  // settings are for trying it the way a hosted server runs it. Once setup is finished on this
  // machine they do nothing. To try again without losing that setup, point Setup:DataPath at an
  // empty folder. A value left as a "<<placeholder>>" counts as unset.
  // ---------------------------------------------------------------------------------------
  "ark_oauth_server": {
    "Setup": {
      // The setup link, /ark-idp/setup#key=<this value>, which shows the setup code to someone without
      // the server log. 16+ letters and digits: openssl rand -hex 16. On a real server it goes in the
      // platform's settings or a secret store, never in a committed file.
      "AccessKey": "<<at-least-16-characters>>",
      // On localhost in Development the wizard asks for no setup code. true asks for it here too,
      // as everywhere else, so the code and the link can be tried.
      "RequireToken": false
      // "DataPath": "/tmp/ark-idp-try"   // a scratch folder: a fresh wizard, the real setup untouched
    }
  }
}
