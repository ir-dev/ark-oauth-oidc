{
  // Deliberately no ark_oauth_server section: the setup wizard collects it on first run and
  // writes it to ark-idp-data/settings.json. Anything set here, in user secrets or in the
  // environment still wins over the wizard's file, so a pipeline can configure this host the
  // old way and never see the wizard.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
