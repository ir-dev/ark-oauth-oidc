{
  // Deliberately no ark_oauth_server section: the setup wizard collects it on first run and
  // writes it to ark-idp-data/settings.json, which is read after this file and so wins over it.
  // User secrets and the environment still win over the wizard's file, so a pipeline can
  // configure this host the old way and never see the wizard.
  //
  // To let someone without access to the server log run the wizard, set
  // ark_oauth_server__Setup__AccessKey (16+ letters and digits) in the platform's settings or a
  // secret store, never here, and send them {public address}/ark-idp/setup#key=<that value>.
  // On this machine: appsettings.Development.json, copied from appsettings.Development.sample.json
  // (gitignored).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
