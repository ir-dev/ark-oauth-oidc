@*
    The MCP endpoints of this server, to look through and open in a new tab.

    An endpoint answers POST and nothing else (Mcp/ArkMcpController.cs), so its own address shows
    an empty 405 in a browser. What opens here is the public documents beside it, which are the
    same for everybody and hold no secret.

    Operator only, and 404 while MCP is switched off (AdminController.Mcp). The page is a shell:
    the list comes from the management API (/api/oauth/v1/mcp/endpoints), so a script gets the
    same one.

    Self-contained for the same reason the other console pages are: a view rendered out of a
    NuGet package cannot assume the host has a layout, a _ViewStart or tag helpers.
*@
@{
    Layout = null;
    var tenant = ViewBag.Tenant as Ark.oAuth.ArkTenant;
    var title = tenant?.display ?? tenant?.name ?? (ViewBag.TenantId as string);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin" />
    <title>MCP endpoints — @title</title>
    <link href="@ViewBag.ConsoleCss" rel="stylesheet" />
    <link href="@ViewBag.ThemeCss" rel="stylesheet" />
    @* Not deferred: applies the viewer's saved theme and text size before the first paint. *@
    <script src="@ViewBag.ThemeJs"></script>
</head>
<body>
@await Html.PartialAsync("_ConsoleHeader")

<main class="ark-main"
      id="ark-admin"
      data-page="mcp"
      data-app-root="@ViewBag.AppRoot"
      data-tenant-id="@ViewBag.TenantId">

    <section class="ark-panel">
        <div class="ark-panel-head">
            <h2>MCP endpoints</h2>
            <span class="ark-hint" id="mcp-count" aria-live="polite"></span>
            <span class="ark-spacer"></span>
            <input type="text" id="mcp-search" placeholder="Search name, id or address…" aria-label="Search MCP endpoints" autocomplete="off" />
            <select id="mcp-tenant" aria-label="Tenant"><option value="">All tenants</option></select>
            <select id="mcp-level" aria-label="Level">
                <option value="">All levels</option>
                <option value="host">Host</option>
                <option value="tenant">Tenant</option>
                <option value="client">Client</option>
            </select>
        </div>
        <div class="ark-panel-body">
            <p class="ark-mcp-note">
                An agent connects to the address. It answers only an agent, so a browser opens the public
                documents beside it instead, each in a new tab: the <strong>server card</strong> (what the endpoint
                is and how to sign in to it), the <strong>configuration</strong> an MCP client takes, and the
                <strong>metadata</strong> OAuth clients discover it by.
                <span id="mcp-off"></span>
            </p>
            <div class="ark-table-wrap">
                <table class="ark-table ark-mcp-table">
                    <thead>
                        <tr>
                            <th scope="col">Level</th>
                            <th scope="col">Name</th>
                            <th scope="col">Address</th>
                            <th scope="col">Open in a new tab</th>
                        </tr>
                    </thead>
                    <tbody id="mcp-rows"><tr><td colspan="4"><p class="ark-empty">Loading…</p></td></tr></tbody>
                </table>
            </div>
        </div>
    </section>
</main>

@await Html.PartialAsync("_ConsoleFooter")

<div class="ark-toasts" id="ark-toasts" aria-live="polite"></div>

<script src="@ViewBag.ConsoleJs"></script>
</body>
</html>
