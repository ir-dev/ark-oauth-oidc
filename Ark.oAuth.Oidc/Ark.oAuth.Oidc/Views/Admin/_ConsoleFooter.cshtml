@*
    The console's footer.

    A partial for the same reason _ConsoleHeader is one: both console pages set Layout = null, so
    without this the one line naming the build would be two lines to keep in step.

    It exists to answer "which version is this?" without a shell on the server. The console is
    served out of the package, so the screen and the assembly are the same release — the number
    here is the one to quote when a behaviour on this page does not match the documentation.
*@
<footer class="ark-console-foot">
    <span>@ViewBag.HostName</span>
    <span class="ark-console-foot-sep" aria-hidden="true"></span>
    @* ark_oauth_server:ShowPoweredBy. The version stays either way: it is what this footer is for. *@
    @if (ViewBag.ShowPoweredBy is not false)
    {
        <a class="ark-powered" href="https://github.com/ir-dev/ark-oauth-oidc" target="_blank" rel="noopener noreferrer">
            <img src="@ViewBag.ShieldUrl" alt="" width="20" height="20" />
            <span>Powered by <strong>Ark Identity Server</strong></span>
        </a>
        <span class="ark-console-foot-sep" aria-hidden="true"></span>
    }
    <span>Ark.oAuth.Oidc <code>@ViewBag.PackageVersion</code></span>
    @*
        The audit trail (ark_oauth_server:Watch), drawn only when one is configured: where it goes
        and whether events are arriving. "Waiting" means the node is away and events are held;
        "losing" means some were dropped or refused, which the counters in the tooltip break down.
        Live figures: GET /api/oauth/v1/watch/status.
    *@
    @if (ViewBag.AuditTrail is Ark.oAuth.Oidc.ArkWatchStatus audit && audit.enabled)
    {
        var auditHost = Uri.TryCreate(audit.endpoint, UriKind.Absolute, out var auditUri) ? auditUri.Authority : audit.endpoint;
        var auditText = audit.health == "ok" ? "sending" : audit.health == "waiting" ? "waiting for the node" : "losing events";
        <span class="ark-console-foot-sep" aria-hidden="true"></span>
        <span class="ark-audit-state" data-health="@audit.health"
              title="Audit trail to ARK-RAPID Watch at @audit.endpoint as @audit.application (@audit.environment). Logged @audit.logged, sent @audit.sent, held on disk @audit.spooled, replayed @audit.replayed, refused @audit.rejected, dropped @audit.dropped, send failures @audit.send_failures.@(audit.spool ? "" : " No spool folder: events are held in memory only while the node is away.")">
            <span class="ark-audit-dot" aria-hidden="true"></span>
            <span>Audit trail: <code>@auditHost</code>, @auditText</span>
        </span>
    }
</footer>
