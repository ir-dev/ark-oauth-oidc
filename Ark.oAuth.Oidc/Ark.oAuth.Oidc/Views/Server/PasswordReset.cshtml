@*
    Password reset.

    Rebuilt on the shared IdP layout. The previous version pulled Tailwind 1.1.2 and a stock
    photo from two different CDNs, and shipped an unclosed <form> tag.
*@
@{
    Layout = "~/Views/Oidc/_ArkLayout.cshtml";
    var cfg = ViewBag.config as Ark.oAuth.Oidc.ArkEmailConfig;
    ViewBag.Brand = new Ark.oAuth.Oidc.Endpoints.OidcBrandModel
    {
        HostLogo = cfg?.host_logo,
        ClientLogo = cfg?.client_logo,
        HostName = cfg?.host_company_display ?? cfg?.host_company_name ?? "Identity Provider",
        PrivacyUrl = cfg?.privacy_policy_url,
        TermsUrl = cfg?.terms_url
    };
    ViewBag.PageTitle = "Set your password";
    bool isError = ViewBag.IsError ?? false;
}

<h1>Set your password</h1>
<p class="ark-sub">Choose a new password for your account.</p>

@if (isError)
{
    <div class="ark-alert ark-alert-error" role="alert">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" />
            <path d="M8 4.6v4.2M8 11.2h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span>@ViewBag.msg</span>
    </div>
}

<form method="post" autocomplete="on">
    <div class="ark-field">
        <label for="pw1">New password</label>
        <input id="pw1" name="pw1" class="ark-input" type="password"
               autocomplete="new-password" required autofocus placeholder="••••••••" />
    </div>
    <div class="ark-field">
        <label for="pw2">Confirm new password</label>
        <input id="pw2" name="pw2" class="ark-input" type="password"
               autocomplete="new-password" required placeholder="••••••••" />
    </div>
    <div class="ark-actions">
        <button class="ark-btn ark-btn-secondary" type="submit" name="action_type" value="Cancel">Cancel</button>
        <button class="ark-btn ark-btn-primary" type="submit" name="action_type" value="Update">Update password</button>
    </div>
</form>

<p class="ark-meta">This link can only be used once.</p>
