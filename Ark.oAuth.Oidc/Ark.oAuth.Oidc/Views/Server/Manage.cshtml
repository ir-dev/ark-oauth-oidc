@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.tenant.display : IdP </title>
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet">
    <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/ark-js-util@1.0.15/ark-util.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/ark-js-alert@1.0.2/ark-alert.min.js"></script>
    <style>
        /* ------------------------------------------------------------------
           Admin console.

           Shares the design tokens used by the sign-in and consent pages, so the
           whole IdP reads as one product. Replaces the previous Bootstrap-3-era
           float layout, the Font Awesome download it never really used, and the
           three separate copies of Tabulator that were being pulled in.
           ------------------------------------------------------------------ */
        :root {
            color-scheme: light dark;
            --ark-bg: #f4f6fb;
            --ark-surface: #ffffff;
            --ark-surface-2: #f7f9fc;
            --ark-fg: #16192b;
            --ark-fg-muted: #5b6478;
            --ark-border: #dfe4ee;
            --ark-border-strong: #c6cddc;
            --ark-accent: #3457d5;
            --ark-accent-hover: #2b48b4;
            --ark-accent-fg: #ffffff;
            --ark-accent-soft: #eef2fe;
            --ark-danger: #c0362c;
            --ark-success: #1c7a4a;
            --ark-shadow: 0 1px 2px rgba(16,24,40,.04), 0 8px 24px -10px rgba(16,24,40,.14);
            --ark-radius: 14px;
            --ark-radius-sm: 9px;
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --ark-bg: #0d1017;
                --ark-surface: #171c28;
                --ark-surface-2: #1e2432;
                --ark-fg: #e8ecf5;
                --ark-fg-muted: #99a3b8;
                --ark-border: #2a3244;
                --ark-border-strong: #3a445c;
                --ark-accent: #7b96ff;
                --ark-accent-hover: #93a9ff;
                --ark-accent-fg: #0d1017;
                --ark-accent-soft: #1b2440;
                --ark-danger: #ff8b80;
                --ark-success: #6ede9f;
                --ark-shadow: 0 1px 2px rgba(0,0,0,.3), 0 10px 30px -12px rgba(0,0,0,.6);
            }
        }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0; padding: 0;
            background: var(--ark-bg);
            color: var(--ark-fg);
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 14px;
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
        }

        img { max-width: 100%; }
        a { color: var(--ark-accent); text-decoration: none; }
        a:hover { text-decoration: underline; }

        /* ---------- top bar ---------- */
        .ark-topbar {
            position: sticky; top: 0; z-index: 40;
            display: flex; align-items: center; gap: 16px;
            padding: 0 22px; height: 60px;
            background: var(--ark-surface);
            border-bottom: 1px solid var(--ark-border);
        }
        .ark-topbar img { max-height: 30px; max-width: 130px; object-fit: contain; }
        .ark-topbar-title { font-weight: 650; letter-spacing: -.01em; font-size: 15px; }
        .ark-topbar-spacer { flex: 1; }
        .ark-topbar-user { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ark-fg-muted); }
        .ark-avatar {
            width: 30px; height: 30px; border-radius: 50%;
            display: grid; place-items: center;
            background: var(--ark-accent-soft); color: var(--ark-accent);
            font-weight: 650; font-size: 12px;
        }

        /* ---------- layout ---------- */
        .ark-main { max-width: 1400px; margin: 0 auto; padding: 24px 22px 60px; }

        .ark-panel {
            background: var(--ark-surface);
            border: 1px solid var(--ark-border);
            border-radius: var(--ark-radius);
            box-shadow: var(--ark-shadow);
            margin-bottom: 22px;
            overflow: hidden;
        }
        .ark-panel-head {
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
            padding: 15px 18px;
            border-bottom: 1px solid var(--ark-border);
            background: var(--ark-surface-2);
        }
        .ark-panel-head h2 { margin: 0; font-size: 14px; font-weight: 650; letter-spacing: -.005em; }
        .ark-panel-head .ark-hint { font-size: 12.5px; color: var(--ark-fg-muted); font-weight: 400; }
        .ark-panel-head .ark-spacer { flex: 1; }
        .ark-panel-body { padding: 16px 18px; }

        /* ---------- controls ---------- */
        button, .ark-btn {
            font: inherit; font-weight: 600; font-size: 13px;
            padding: 7px 14px;
            border-radius: var(--ark-radius-sm);
            border: 1px solid transparent;
            background: var(--ark-accent); color: var(--ark-accent-fg);
            cursor: pointer;
            transition: background .15s, border-color .15s;
        }
        button:hover, .ark-btn:hover { background: var(--ark-accent-hover); }
        button:focus-visible, select:focus-visible, input:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--ark-accent) 35%, transparent);
        }
        button.ark-btn-ghost {
            background: var(--ark-surface); color: var(--ark-fg);
            border-color: var(--ark-border-strong);
        }
        button.ark-btn-ghost:hover { background: var(--ark-surface-2); border-color: var(--ark-accent); }

        select, input[type=text], input[type=email], input[type=password] {
            font: inherit; font-size: 13px;
            padding: 7px 11px;
            color: var(--ark-fg);
            background: var(--ark-surface);
            border: 1px solid var(--ark-border-strong);
            border-radius: var(--ark-radius-sm);
        }
        select:hover, input:hover { border-color: var(--ark-accent); }

        /* ---------- claims mapping ---------- */
        .ark-map { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
        #tabulator-table { flex: 1 1 520px; min-width: 320px; }

        #external-menu {
            flex: 0 0 240px;
            background: var(--ark-surface-2);
            border: 1px solid var(--ark-border);
            border-radius: var(--ark-radius-sm);
            padding: 14px;
        }
        #external-menu h4 {
            margin: 0 0 10px; font-size: 12px; font-weight: 650;
            text-transform: uppercase; letter-spacing: .06em; color: var(--ark-fg-muted);
        }
        #external-menu input { width: 100%; margin-bottom: 10px; }
        #tag-list { display: flex; flex-wrap: wrap; gap: 6px; }
        #tag-list .tag, .tag {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 99px;
            font-size: 12px; font-weight: 550;
            background: var(--ark-accent-soft); color: var(--ark-accent);
            border: 1px solid color-mix(in srgb, var(--ark-accent) 28%, transparent);
            cursor: grab;
        }
        #tag-list .tag:active, .tag:active { cursor: grabbing; }

        /* ---------- tabulator theming ---------- */
        .tabulator {
            background: var(--ark-surface);
            border: 1px solid var(--ark-border);
            border-radius: var(--ark-radius-sm);
            font-size: 13px;
        }
        .tabulator .tabulator-header {
            background: var(--ark-surface-2);
            border-bottom: 1px solid var(--ark-border);
            color: var(--ark-fg-muted);
            font-weight: 600;
        }
        .tabulator .tabulator-header .tabulator-col {
            background: transparent;
            border-right: 1px solid var(--ark-border);
        }
        .tabulator .tabulator-row { background: var(--ark-surface); border-bottom: 1px solid var(--ark-border); }
        .tabulator .tabulator-row.tabulator-row-even { background: var(--ark-surface-2); }
        .tabulator .tabulator-row:hover { background: var(--ark-accent-soft); }
        .tabulator .tabulator-row .tabulator-cell { border-right: 1px solid var(--ark-border); color: var(--ark-fg); }
        .tabulator .tabulator-footer {
            background: var(--ark-surface-2);
            border-top: 1px solid var(--ark-border);
            color: var(--ark-fg-muted);
        }
        .tabulator-edit-select-list, .tabulator .tabulator-cell input {
            background: var(--ark-surface); color: var(--ark-fg);
        }

        @@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }

        @@media (max-width: 720px) {
            .ark-topbar { padding: 0 14px; }
            .ark-main { padding: 16px 14px 48px; }
            .ark-topbar-title { display: none; }
        }
    </style>
</head>

<body>
    <header class="ark-topbar">
        @if (!string.IsNullOrEmpty(ViewBag.host_logo as string))
        {
            <img src="@ViewBag.host_logo" alt="" />
        }
        <span class="ark-topbar-title">@ViewBag.tenant.display</span>
        <span class="ark-topbar-spacer"></span>
        <div class="ark-topbar-user">
            <span class="ark-avatar">@(((string)(ViewBag.profile?.user?.name ?? "?")).Substring(0, 1).ToUpperInvariant())</span>
            <span>@ViewBag.profile?.user?.name</span>
            <button id="logoff" class="ark-btn-ghost" type="button">Sign out</button>
        </div>
    </header>

    <main class="ark-main">
        <section class="ark-panel">
            <div class="ark-panel-head">
                <h2>Tenants</h2>
                <span class="ark-hint">signing keys, issuer and audience</span>
                <span class="ark-spacer"></span>
                <button id="tenant-add" type="button">Add tenant</button>
            </div>
            <div class="ark-panel-body"><div id="tbl_tenant"></div></div>
        </section>

        <section class="ark-panel">
            <div class="ark-panel-head">
                <h2>Clients</h2>
                <span class="ark-hint">applications allowed to request tokens</span>
                <span class="ark-spacer"></span>
                <button id="client-add" type="button">Add client</button>
            </div>
            <div class="ark-panel-body"><div id="tbl_client"></div></div>
        </section>

        <section class="ark-panel">
            <div class="ark-panel-head">
                <h2>Users</h2>
                <span class="ark-hint">accounts that can sign in</span>
                <span class="ark-spacer"></span>
                <button id="user-add" type="button">Add user</button>
            </div>
            <div class="ark-panel-body"><div id="tbl_user"></div></div>
        </section>

        <section class="ark-panel">
            <div class="ark-panel-head">
                <h2>Access mapping</h2>
                <span class="ark-hint">which claims a user carries for a given client</span>
                <span class="ark-spacer"></span>
                <select id="sel-user" aria-label="User">
                    <option value="">Select user</option>
                </select>
                <select id="sel-tenant" aria-label="Tenant">
                    <option value="">Select tenant</option>
                </select>
                <button id="user1-add" type="button">Add mapping</button>
            </div>
            <div class="ark-panel-body">
                <div class="ark-map">
                    <div id="tabulator-table"></div>
                    <aside id="external-menu">
                        <h4>Claims</h4>
                        <input type="text" id="new-tag-input" placeholder="Add a claim…" />
                        <div id="tag-list"><!-- draggable claims --></div>
                    </aside>
                </div>
            </div>
        </section>
    </main>

    <script>
			// External tag management
			// let externalTags = [
			//     "sub", "iss", "aud", "exp", "iat", "name", "family_name", "given_name", "email", "email_verified", "gender", "phone_number", "address"
			// ];
			let externalTags = [];

			function renderTags() {
			  const container = document.getElementById("tag-list");
			  container.innerHTML = "";
			  externalTags.forEach((tag, index) => {
				const el = document.createElement("div");
				el.className = "draggable-item";
				el.setAttribute("draggable", "true");
				el.dataset.tag = tag;
				el.innerHTML = `
				  <span>${tag}</span>
				  <button onclick="removeExternalTag(${index})">&times;</button>
				`;
				el.addEventListener("dragstart", e => {
				  e.dataTransfer.setData("text/plain", tag);
				});
				container.appendChild(el);
			  });
			}

			function removeExternalTag(index) {
			  externalTags.splice(index, 1);
			  renderTags();
			}

			document.getElementById("new-tag-input").addEventListener("keypress", e => {
			  if (e.key === "Enter") {
				const value = e.target.value.trim();
				if (value && !externalTags.includes(value)) {
				  fetch('@ViewBag.base_path/api/oauth/v1/claim/upsert', {
							method: "POST",
							body: JSON.stringify({
								key: value,
								display: value
							}),
							headers: {
								'Accept': 'application/json',
								'Content-Type': 'application/json'
							}
						})
						.then(t => t.json())
						.then(t => {
							externalTags.unshift(value);
							renderTags();
							ark_alert.alert('s', `saved tenant succesfully`, 3000);
						});
				  e.target.value = "";
				}
			  }
			});

		let tableData= [], table;
		var load_user_claims = () => {
			if (table && table.clearData) table.clearData();
			var laod_tbl = () => {
				table = new Tabulator("#tabulator-table", {
				  height: "300px",
				  data: tableData,
				  layout:"fitDataFill",
				  columns: [
					{ title: "Email", field: "email" },
					{ title:"Tenant", field:"tenant_id" },
					{
						title:"Client",
						field:"client_id",
						editor:"list",
						editorParams: {
							//values: tbl_client.table.getData().filter(t => t.tenant_id == u_tnt).map(t => t.client_id)
							values: tbl_client.table.getData().filter(t => t.tenant_id == u_tnt).reduce((accm, itm) => {
								accm[itm.id] = `${itm.display} (${itm.tenant_id})`;
								return accm;
							}, {}),
						}
					},
					{
					  title: "Drop Claims Here",
					  field: "claims",
					  width: 300,
					  formatter: (cell) => {
						const itms = cell.getValue();
						var contain = ark_util.textToDom(`<div class="drop-cell" style="display:flex; flex-wrap: wrap;" ondrop="handleDrop(event, ${cell.getRow().getPosition()})" ondragover="event.preventDefault()"></div>`);
						(itms || []).forEach((t, ix) => {
							var dd = ark_util.textToDom(`<span class="tag">${t}<button>×</button></span>`);
							dd.querySelector('button').addEventListener('click', evt => {
								itms.splice(ix, 1);
								dd.remove();
							});
							contain.appendChild(dd);
						});
						return contain;
					  }
					},
					{
						formatter: () => `<button>Save</button>`,
						field: "save",
						width:60,
						hozAlign:"center",
						cellClick:function(e, cell) {
							//alert("Printing row data for: " + cell.getRow().getData().name)
							var tg = cell.getRow().getData();
							//tg.active = tg.active == 'true' ? true: false;
							console.log('save clicked,', tg);
							fetch('@ViewBag.base_path/api/oauth/v1/user/client/claims/upsert', {
							method: "POST",
							body: JSON.stringify(tg),
							headers: {
								'Accept': 'application/json',
								'Content-Type': 'application/json'
								}
							})
							.then(t => t.json())
							.then(t => {
								if (t.error) ark_alert.alert('f', `user client claims saving failed`, 5000);
								else ark_alert.alert('s', `saved user client claims succesfully`, 3000);
							});
						}
					},
					{
						formatter: () => `<button>Delete</button>`,
						field: "delete",
						width:60,
						hozAlign:"center",
						cellClick:function(e, cell) {
							//alert("Printing row data for: " + cell.getRow().getData().name)
							var tg = cell.getRow().getData();
							tg.active = tg.active == 'true' ? true: false;
							fetch('@ViewBag.base_path/api/oauth/v1/user/client/claims/delete', {
								method: "POST",
								body: JSON.stringify(tg),
								headers: {
									'Accept': 'application/json',
									'Content-Type': 'application/json'
								}
							})
							.then(t => t.json())
							.then(t => {
								if (t.error) ark_alert.alert('f', `${t.msg}`, 3000);
								else {
									cell.getRow().delete();
									ark_alert.alert('s', `${t.msg}`, 3000);
								}
							});
						}
                      },
                    {
						formatter: (cell, formatterParams, onRendered) => {
							var tg = cell.getRow().getData();
                            return (tg.claims || []).indexOf('service_role') > -1 ? `<button>Regenerate Token</button>` : '';
						},
						field: "",
						width: 160,
						hozAlign: "center",
						cellClick: function (e, cell) {
							//alert("Printing row data for: " + cell.getRow().getData().name)
							var tg = cell.getRow().getData();
							if (tg.type != 'service') return;
							//tg.active = tg.active == 'true' ? true: false;
							console.log('reset pw clicked,', tg);
							fetch('@ViewBag.base_path/api/oauth/v1/service/pw/reset', {
								method: "POST",
								body: JSON.stringify(tg),
								headers: {
									'Accept': 'application/json',
									'Content-Type': 'application/json'
								}
							})
							.then(t => t.json())
							.then(t => {
								if (t.error) ark_alert.alert('f', `${t.msg}`, 3000);
								else ark_alert.alert('s', `${t.msg}`, 3000);
							});
						}
					}
				  ],
				});
			}
			var user_id = document.querySelector("#sel-user").value;
			var u_tnt = document.querySelector("#sel-tenant").value;
			if (user_id && u_tnt) {
				fetch(`@ViewBag.base_path/api/oauth/v1/user/list/client/claims/mapping/${user_id}/${u_tnt}`)
				.then(t => t.json())
				.then(t => {
					tableData = t.data;
					laod_tbl();
				});
			} else {
				tableData = [];
					laod_tbl();
			}
		}
			// Drop handling
		window.handleDrop = function (e, rowIndex) {
		  e.preventDefault();
		  const data = e.dataTransfer.getData("text/plain");
		  const row = table.getRowFromPosition(rowIndex, true);
		  var dtt = row.getData();
		  dtt.claims = dtt.claims || [];
		  const cell = row.getCell("claims");
		  //const itms = cell.getValue();
		  var itms = dtt.claims;
		  var contain = cell.getElement().querySelector('.drop-cell');
		  if (itms.indexOf(data) < 0) {
			  ((idx) => {
				var dd = ark_util.textToDom(`<span class="tag">${data}<button>×</button></span>`);
				dd.querySelector('button').addEventListener('click', evt => {
					itms.splice(idx, 1);
					dd.remove();
				});
				itms.push(data);
				table.updateData([dtt]);
				contain.appendChild(dd);
			  })(itms.length);
		  }
		};


		function removeTagFromCell(rowIndex, tagText) {
			const row = table.getRowFromPosition(rowIndex, true);
			const cell = row.getCell("claims");
			const html = cell.getValue()  || [];

			const tagRegex = new RegExp(`<span class="tag"[^>]*>${tagText}<button[^>]*>×<\\/button><\\/span>`, 'g');
			const updated = html.replace(tagRegex, '');

			cell.setValue(updated);
		}

		document.getElementById("user1-add").addEventListener("click", evt => {
			if (document.getElementById("sel-user").value && document.getElementById("sel-tenant").value) {
				table.addRow({ email : document.getElementById("sel-user").value, tenant_id: document.getElementById("sel-tenant").value });
			} else {
				ark_alert.alert('w', `please select both user & tenant id, to map clients and claims.`, 3000);
			}
		});
		// Initial render
		//renderTags();
		fetch('@ViewBag.base_path/api/oauth/v1/claim/list')
		.then(t => t.json())
		.then(t => {
			externalTags = t.data.map(t1 => t1.key);
			renderTags();
		});
    </script>

    @*
        Removed from here: Modernizr 2.8.3 (nothing referenced it), a Google Fonts stylesheet
        (the page now uses the system font stack, so it costs a third-party request for nothing),
        and two further copies of Tabulator loaded from an unpinned URL. Unpinned meant the admin
        console silently took whatever version was published that day. Tabulator is now loaded
        once, at a pinned version, in <head>.
    *@
    <script>
        const master_table = (opt) => {
            //custom formatter definition
            var printIcon = function (cell, formatterParams, onRendered) { //plain text value
                return "<i class='fa fa-print'></i>";
            };
            let tableMaster = new Tabulator(opt.selector, {
                data: opt.data, //assign data to table
                autoColumns: true, //create columns from data field names
                autoColumnsDefinitions: function (definitions) {
                    definitions.forEach((column) => {
                        if (column.field == 'active') {
                            column.editor = "list";
                            column.editorParams = {
                                values: ["true", "false"]
                            };
                        } else {
                            column.editor = "input";
                        }
                    });

                    definitions.push({
                        formatter: () => `<button>Save</button>`,
                        field: "save",
                        width: 60,
                        hozAlign: "center",
                        cellClick: function (e, cell) {
                            //alert("Printing row data for: " + cell.getRow().getData().name)
                            var tg = cell.getRow().getData();
                            tg.active = tg.active == 'true' ? true : false;
                            if (opt.onsave) opt.onsave(tg);
                        }
                    });

                    definitions.splice()
                    return definitions;
                }
            });
            return {
                reset: () => {
                    tableMaster.clearCellEdited();
                },
                table: tableMaster
            }
        }
    </script>
    <script>
		var tbl_tenant, ten_lst;
		var load_tenant = () => {
			fetch('@ViewBag.base_path/api/oauth/v1/tenant/list')
			.then(t => t.json())
			.then(t => {
				tbl_tenant = master_table({
					data: t.data,
					selector: '#tbl_tenant',
					onsave: (tg) => {
						fetch('@ViewBag.base_path/api/oauth/v1/tenant/upsert', {
								method: "POST",
								body: JSON.stringify(tg),
								headers: {
									'Accept': 'application/json',
									'Content-Type': 'application/json'
								}
							})
							.then(t => t.json())
							.then(t => {
								ark_alert.alert('s', `saved tenant succesfully`, 3000);
								load_tenant();
							});
					}
				});
				ten_lst = t.data;
				var scc = document.querySelector("#sel-tenant");
				scc.innerHTML = '';
				scc.add(new Option('Select Tenant', ''));
				(t.data || []).forEach(tt => {
					scc.add(new Option(tt.name, tt.tenant_id));
				});
				scc.addEventListener('change', evt => {
					load_user_claims(evt.target.value);
				});
				load_client();
			});
		}
		document.getElementById("tenant-add").addEventListener("click", evt => {
			tbl_tenant.table.addRow({});
		});
		load_tenant();
    </script>
    <script>
		var tbl_client;
		var load_client = () => {
			fetch('@ViewBag.base_path/api/oauth/v1/client/list')
			.then(t => t.json())
			.then(t => {
				tbl_client = master_table({
					data: t.data,
					selector: '#tbl_client',
					onsave: (tg) => {
						fetch('@ViewBag.base_path/api/oauth/v1/client/upsert', {
								method: "POST",
								body: JSON.stringify(tg),
								headers: {
									'Accept': 'application/json',
									'Content-Type': 'application/json'
								}
							})
							.then(t => t.json())
							.then(t => {
								//ark_alert.alert('s', `saved client succesfully`, 3000);
								if (t.error) ark_alert.alert('f', `${t.msg}`, 3000);
								else {
									ark_alert.alert('s', `${t.msg}`, 3000);
									load_client();
								}
							});
					}
				});
				setTimeout(() => {
					//tbl_client.table.deleteColumn('id');
					tbl_client.table.deleteColumn('tenant_id');
                    tbl_client.table.deleteColumn('tenant');
                    tbl_client.table.deleteColumn('client_logo');
					tbl_client.table.addColumn({
						title:"tenant_id",
						field:"tenant_id",
						editor:"list",
						editorParams:{
							values: ten_lst.reduce((accm, itm) => {
								accm[itm.tenant_id] = itm.name;
								return accm;
							}, {}),
							clearable:false,
							multiselect: false,
							placeholderEmpty:"No Results Found"
						}
					}, true, 'client_id');
					tbl_client.table.addColumn({
						formatter: () => `<button>Delete</button>`,
						field: "delete",
						width:60,
						hozAlign:"center",
						cellClick:function(e, cell) {
							//alert("Printing row data for: " + cell.getRow().getData().name)
							var tg = cell.getRow().getData();
							tg.active = tg.active == 'true' ? true: false;
							fetch('@ViewBag.base_path/api/oauth/v1/client/delete', {
								method: "POST",
								body: JSON.stringify(tg),
								headers: {
									'Accept': 'application/json',
									'Content-Type': 'application/json'
								}
							})
							.then(t => t.json())
							.then(t => {
								if (t.error) ark_alert.alert('f', `${t.msg}`, 3000);
								else {
									cell.getRow().delete();
									ark_alert.alert('s', `${t.msg}`, 3000);
								}
							});
						}
					});
					tbl_client.table.addColumn({
                        title: "client_logo",
                        field: "client_logo",
                        editable: true,
						formatter: function (cell) {
                            const value = cell.getValue();
                            const container = document.createElement("div");
                            container.style.display = "flex";
                            container.style.alignItems = "center";
                            container.style.justifyContent = "center";
                            container.style.height = "100%";

                            if (value) {
                                const img = document.createElement("img");
                                img.src = value;
                                img.style.maxHeight = "50px";
                                img.style.maxWidth = "100px";
                                img.style.objectFit = "contain";
                                container.appendChild(img);
                            } else {
                                container.textContent = "Click to upload";
                                container.style.color = "#999";
                            }

                            return container;
						},
                        editor: function (cell, onRendered, success, cancel) {
                            const container = document.createElement("div");
                            container.style.display = "flex";
                            container.style.flexDirection = "column";
                            container.style.gap = "10px";

                            // Hidden file input
                            const fileInput = document.createElement("input");
                            fileInput.type = "file";
                            fileInput.accept = "image/*";
                            fileInput.style.display = "none";

                            // Upload button
                            const uploadBtn = document.createElement("button");
                            uploadBtn.textContent = "Upload Image";
                            uploadBtn.addEventListener("click", function (e) {
                                e.stopPropagation();
                                fileInput.click();
                            });

                            // Handle file selection
                            fileInput.addEventListener("change", function (e) {
                                const file = e.target.files[0];
                                if (file) {
                                    const reader = new FileReader();
                                    reader.onload = function (e) {
                                        success(e.target.result);
                                    };
                                    reader.readAsDataURL(file);
                                }
                            });

                            container.appendChild(fileInput);
                            container.appendChild(uploadBtn);
                            return container;
                        }
                    }, true, 'name');
					tbl_client.table.addColumn({
						title:"Config",
						formatter: function(cell, formatterParams, onRendered){
							//cell - the cell component
							//formatterParams - parameters set for the column
							//onRendered - function to call when the formatter has been rendered
							var dd = cell.getRow().getData();
							if (dd && dd.client_id && dd.tenant_id) return `<a href='@ViewBag.base_path/oauth/${dd.tenant_id}/v1/.well-known/${dd.client_id}/openid-configuration' target='_blank'>config</a>`
							return '';
						}
					});
				}, 2000);
			});
		}
		document.getElementById("client-add").addEventListener("click", evt => {
				tbl_client.table.addRow({});
		});
    </script>
    <script>
		var tbl_user;
		fetch('@ViewBag.base_path/api/oauth/v1/user/list')
		.then(t => t.json())
		.then(t => {
			tbl_user = new Tabulator("#tbl_user", {
				  data: t.data,
				  layout:"fitDataFill",
				  columns: [
					{ title: "Email", field: "email", editor: "input" },
					{ title: "name", field: "name", editor: "input" },
					{ title: "Ref UID", field: "ref_uid", editor: "input" },
					{
						title:"emailed",
						field:"emailed",
						editor:"list",
						editorParams:{ values:[ true, false ] }
					},
					{
						title:"reset_mode",
						field:"reset_mode",
						editor:"list",
						editorParams:{ values:[ true, false ] }
					},
					{
						title:"type",
						field:"type",
						editor:"list",
						editorParams:{ values:[ 'user', 'service' ] }
					  },
					{
						formatter: () => `<button>Save</button>`,
						field: "save",
						width:60,
						hozAlign:"center",
						cellClick:function(e, cell) {
							fetch('@ViewBag.base_path/api/oauth/v1/user/upsert', {
								method: "POST",
								body: JSON.stringify(cell.getRow().getData()),
								headers: {
									'Accept': 'application/json',
									'Content-Type': 'application/json'
								}
							})
							.then(t => t.json())
							.then(t => {
								if (t.error) ark_alert.alert('f', `${t.msg}`, 5000);
								else ark_alert.alert('s', `saved user succesfully`, 2000);
							});
						}
					},
					{
						formatter: () => `<button>Reset Password</button>`,
						field: "reset_pw",
						width:160,
						hozAlign:"center",
						cellClick:function(e, cell) {
							//alert("Printing row data for: " + cell.getRow().getData().name)
							var tg = cell.getRow().getData();
							//tg.active = tg.active == 'true' ? true: false;
							console.log('reset pw clicked,', tg);
							fetch('@ViewBag.base_path/api/oauth/v1/user/pw/reset/init', {
							method: "POST",
							body: JSON.stringify(tg),
							headers: {
								'Accept': 'application/json',
								'Content-Type': 'application/json'
								}
							})
							.then(t => t.json())
							.then(t => {
								if (t.error) ark_alert.alert('f', `${t.msg}`, 3000);
								else ark_alert.alert('s', `${t.msg}`, 3000);
							});
						}
                      }
					]
				});
			var scc = document.querySelector("#sel-user");
			(t.data || []).forEach(tt => {
				scc.add(new Option(tt.name, tt.email));
			});
			scc.addEventListener('change', evt => {
				load_user_claims(evt.target.value);
			});
		});
		document.getElementById("user-add").addEventListener("click", evt => {
			tbl_user.addRow({});
		});
    </script>
    <script>
		document.getElementById("logoff").addEventListener("click", evt => {
			fetch('@ViewBag.logout_url').then(t => {
				window.location.href = '@ViewBag.base_path';
			});
		});
    </script>
</body>
</html>