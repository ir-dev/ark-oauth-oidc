@*
    Sign-in page for the deprecated /v1 authorize endpoint.

    Restyled onto the shared layout so the two flows look identical during migration. New
    integrations use /{tenant_id}/oauth2/authorize, which renders ~/Views/Oidc/Login.cshtml.
*@
@{
    Layout = "~/Views/Oidc/_ArkLayout.cshtml";
    ViewBag.Brand = new Ark.oAuth.Oidc.Endpoints.OidcBrandModel
    {
        HostLogo = ViewBag.host_logo as string,
        ClientLogo = ViewBag.client_logo as string,
        HostName = "Identity Provider"
    };
    ViewBag.PageTitle = "Sign in";
    bool isError = ViewBag.IsError ?? false;
}

<h1>Sign in</h1>
<p class="ark-sub">to continue to your application</p>

@if (isError)
{
    <div class="ark-alert ark-alert-error" role="alert">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" />
            <path d="M8 4.6v4.2M8 11.2h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span>@ViewBag.msg</span>
    </div>
}

<form method="post" name="Login_Form" autocomplete="on">
    <div class="ark-field">
        <label for="ark-username">Username</label>
        <input id="ark-username" class="ark-input" type="text" name="Username"
               autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false"
               required autofocus placeholder="you@@example.com" />
    </div>
    <div class="ark-field">
        <label for="ark-password">Password</label>
        <input id="ark-password" class="ark-input" type="password" name="Password"
               autocomplete="current-password" required placeholder="••••••••" />
    </div>
    <button class="ark-btn ark-btn-primary" type="submit" name="Submit" value="Login" style="margin-top:6px;">Sign in</button>
</form>

@if (!string.IsNullOrEmpty(ViewBag.client_url as string))
{
    <p class="ark-meta"><a href="@ViewBag.client_url" target="_blank" rel="noopener">Client configuration</a></p>
}
