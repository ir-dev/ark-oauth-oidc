@*
    Password reset, done.

    Rebuilt on the shared IdP layout, like PasswordReset.cshtml which leads here — it was the one
    page of the reset flow still on its own stylesheet. The old "Close The Browser" button is gone:
    window.close() only works on a window a script opened, and this one was opened from an email.
*@
@{
    Layout = "~/Views/Oidc/_ArkLayout.cshtml";
    var cfg = ViewBag.config as Ark.oAuth.Oidc.ArkEmailConfig;
    ViewBag.Brand = new Ark.oAuth.Oidc.Endpoints.OidcBrandModel
    {
        HostLogo = cfg?.host_logo,
        ClientLogo = cfg?.client_logo,
        HostName = cfg?.host_company_display ?? cfg?.host_company_name ?? "Identity Provider",
        PrivacyUrl = cfg?.privacy_policy_url,
        TermsUrl = cfg?.terms_url
    };
    ViewBag.PageTitle = "Password updated";
}

<div class="ark-icon-badge ark-icon-badge--success" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M5 10.5l3.2 3.2L15 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</div>

<h1>Password updated</h1>
<p class="ark-sub">You can now sign in with your new password. It is safe to close this window.</p>

<p class="ark-meta">If you didn't request this password reset, contact your administrator immediately.</p>
