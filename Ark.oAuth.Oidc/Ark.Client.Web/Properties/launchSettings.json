{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Ark.Client.Web": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      // The port is part of the registration: the redirect URIs on the client record are matched
      // exactly, so changing it here means changing them on the server too.
      "applicationUrl": "https://localhost:7255;http://localhost:5255",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
