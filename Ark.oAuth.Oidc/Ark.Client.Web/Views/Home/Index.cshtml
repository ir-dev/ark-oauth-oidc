@*
    The model is ArkSetupModel from Ark.oAuth.Client, built by ArkSetupProbe — the same object any
    Ark client application can render. Only this markup is specific to the sample.
*@
@model ArkSetupModel
@{
    ViewData["Title"] = "Setup";
}

<h1>Registering and using this client</h1>
<p class="sub">
    Every value on this page is read live — from local configuration on one side, and from the
    provider's discovery document on the other. Register the client so the two agree, and sign-in
    works.
</p>

@if (!string.IsNullOrEmpty(Model.AuthError))
{
    <div class="note bad">
        <strong>The last sign-in callback failed.</strong><br />
        <code>@Model.AuthError</code>
    </div>
}

@* The provider ships its admin console in the package, at {BaseUrl}/{TenantId}/admin. Every
   registration step below happens there, so the link sits above them rather than inside one. *@
<div class="card" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
    <div style="flex:1;min-width:240px">
        <strong>Built-in admin console</strong><br />
        <span style="color:var(--fg-muted);font-size:13.5px">
            Clients, users, access mapping and signing keys for tenant
            <code>@Model.TenantId</code> — sign in as <code>admin</code> / <code>admin</code> on a
            fresh provider.
        </span><br />
        <code>@Model.AdminConsoleUrl</code>
    </div>
    <a class="btn" href="@Model.AdminConsoleUrl" target="_blank" rel="noopener">Open admin console</a>
</div>

<h2>Step 1 — Run the identity provider</h2>
<div class="card">
    <p style="margin-top:0">
        From the solution root: <code>dotnet run --project Ark.oAuth.Oidc.Host</code>.
        On first run it creates its database, generates a signing key, seeds the scope catalogue
        and creates an <code>admin</code> / <code>admin</code> account.
    </p>
    <div class="kv">
        <div>Configured Authority</div><div><code>@Model.Authority</code></div>
        <div>Discovery document</div><div><code>@Model.DiscoveryUrl</code></div>
        <div>Reachable</div>
        <div>
            @if (Model.DiscoveryOk)
            {
                <span class="pill ok">yes</span>
            }
            else
            {
                <span class="pill bad">no</span> <span style="color:var(--fg-muted)">@Model.DiscoveryError</span>
            }
        </div>
    </div>

    @if (!Model.DiscoveryOk)
    {
        <div class="note bad">
            Until this succeeds nothing else can work — the OpenID Connect handler fetches the same
            document on its first challenge. Check that the provider is running, that the port in
            <code>Authority</code> matches, and that its development certificate is trusted
            (<code>dotnet dev-certs https --trust</code>).
        </div>
    }
    else if (Model.IssuerMismatch)
    {
        <div class="note bad">
            <strong>Issuer mismatch.</strong> The document declares
            <code>@Model.Issuer</code> but this app is configured with
            <code>@Model.Authority</code>. Token validation rejects a mismatched issuer, so
            sign-in will fail at the callback. Usually this means the tenant segment is wrong.
        </div>
    }
</div>

<h2>Step 2 — Register this application as a client</h2>
<div class="card">
    <p style="margin-top:0">
        Sign in to the <a href="@Model.AdminConsoleUrl" target="_blank" rel="noopener">admin console</a>
        at <code>@Model.AdminConsoleUrl</code> and add a client under
        <strong>Clients</strong> with exactly these values. Redirect URIs are matched
        <em>exactly</em> — no wildcards, no prefix matching, no trailing-slash tolerance.
    </p>
    <div class="kv">
        <div>client_id</div><div><code>@Model.ClientId</code></div>
        <div>application_type</div><div><code>web</code></div>
        <div>token_endpoint_auth_method</div>
        <div>
            <code>@(Model.IsConfidential ? "client_secret_post" : "none")</code>
            <span class="pill">@(Model.IsConfidential ? "confidential client" : "public client")</span>
        </div>
        <div>redirect_uris</div><div><code>@Model.RedirectUri</code></div>
        <div>post_logout_redirect_uris</div><div><code>@Model.PostLogoutRedirectUri</code></div>
        <div>grant_types</div><div><code>authorization_code</code>, <code>refresh_token</code></div>
        <div>scopes</div><div><code>@string.Join(" ", Model.Scopes)</code></div>
        <div>require_pkce</div><div><code>true</code></div>
        <div>is_active</div><div><code>true</code></div>
    </div>

    @if (Model.UnsupportedScopes.Count > 0)
    {
        <div class="note warn">
            The provider does not advertise <code>@string.Join(", ", Model.UnsupportedScopes)</code>
            in <code>scopes_supported</code>. A scope the client is not registered for is rejected
            outright rather than silently dropped, so add it to the client's scope list — or stop
            requesting it here.
        </div>
    }

    @if (Model.IsConfidential)
    {
        <div class="note">
            This app is configured with a client secret. Generate it with
            <strong>Regenerate secret</strong> on the client record — it is shown once and stored
            only as a PBKDF2 hash, so it cannot be read back. Keep it in user-secrets or an
            environment variable, not in <code>appsettings.json</code>.
        </div>
    }
    else
    {
        <div class="note">
            A public client has no secret, which is why PKCE is mandatory for it: the
            <code>code_verifier</code> is what proves the caller redeeming the code is the one that
            started the flow. The handler generates and sends it automatically.
        </div>
    }
</div>

<h2>Step 3 — Grant a user access to the client</h2>
<div class="card">
    <p style="margin-top:0">
        This step is easy to miss and it is not optional. Ark authorizes
        <strong>per user, per client</strong>: a user with no mapping to this client cannot sign in
        to it at all, and the sign-in page reports only that the credentials were not recognised.
    </p>
    <p>
        In the <a href="@Model.AdminConsoleUrl" target="_blank" rel="noopener">admin console</a>
        open <strong>Access mapping</strong>, pick the user, pick
        <code>@Model.ClientId</code>, and add the claims they should carry. Identity claims
        (<code>name</code>, <code>email</code>, …) control what appears in the ID token and
        UserInfo; anything else becomes an authorization claim, delivered in the access token as
        <code>ark_claims</code> and projected onto <code>@Model.RoleClaimType</code>
        so <code>[Authorize(Roles = "…")]</code> works against it.
    </p>
    <div class="note">
        Add <code>sample.admin</code> to the mapping to see the <a href="/home/roles">Roles</a> page
        flip from denied to granted. Claim changes take effect at the next sign-in, because they
        are written into the token when it is issued.
    </div>
</div>

<h2>Step 4 — Configure this application</h2>
<div class="card">
    <p style="margin-top:0">
        Two lines of code and one section of configuration. Nothing else in the application knows
        that OAuth exists.
    </p>
    <pre>// Program.cs
builder.Services.AddArkOidcClient(builder.Configuration);
...
app.UseRouting();          // must come first
app.UseAuthentication();
app.UseAuthorization();

// appsettings.json
"ark_oauth_client": {
  "Authority": "@Model.Authority",
  "ClientId": "@Model.ClientId",@Html.Raw(Model.IsConfidential ? "\n  \"ClientSecret\": \"<from user-secrets>\"," : "")
  "Scopes": [@Html.Raw(string.Join(", ", Model.Scopes.Select(s => $"\"{s}\"")))],
  "CallbackPath": "@(Model.RedirectUri.Substring(Model.RedirectUri.LastIndexOf('/')))",
  "SignedOutCallbackPath": "@(Model.PostLogoutRedirectUri.Substring(Model.PostLogoutRedirectUri.LastIndexOf('/')))"
}</pre>
    <div class="note">
        <code>CallbackPath</code> and <code>SignedOutCallbackPath</code> are handled by the OIDC
        handler itself. Do not add controller actions for them — an action at
        <code>@(Model.RedirectUri.Substring(Model.RedirectUri.LastIndexOf('/')))</code>
        shadows the handler and the callback never completes.
    </div>
</div>

<h2>Step 5 — Verify</h2>
<div class="card">
    @if (Model.IsAuthenticated)
    {
        <div class="note ok">
            <strong>Signed in as @(Model.SignedInAs ?? "a user").</strong>
            The full round trip works: authorization request → sign-in → code → token exchange →
            cookie session.
        </div>
        <p style="margin-bottom:0">
            Next: <a href="/home/profile">inspect the claims and tokens</a>,
            <a href="/home/roles">check a role</a>, or
            <a href="/home/downstream">call an API with the access token</a>.
        </p>
    }
    else
    {
        <p style="margin-top:0">
            Use <strong>Sign in</strong> above, or just open a protected page —
            <a href="/home/secure">/home/secure</a> carries <code>[Authorize]</code>, which starts
            the same flow and returns you there afterwards.
        </p>
        <a class="btn" href="/account/login?returnUrl=%2Fhome%2Fprofile">Sign in and show my profile</a>
    }
</div>

<h2>Other flows</h2>
<div class="card">
    <p style="margin-top:0">
        Everything above is the authorization code flow through a web application, where the
        OpenID Connect handler does the work. Three cases it does not cover have their own pages,
        each running live against this provider:
    </p>
    <div class="kv">
        <div><a href="/flows/spa">Single-page app</a></div>
        <div>
            The same authorization code flow with PKCE, run by JavaScript in a public client. No
            secret, no server session, tokens in memory only.
        </div>
        <div><a href="/flows/machine">Client credentials</a></div>
        <div>
            A service authenticating as itself, with no user anywhere in the exchange. For
            scheduled jobs and service-to-service calls.
        </div>
        <div><a href="/flows/register">Dynamic registration</a></div>
        <div>
            Creating a client at runtime over RFC 7591 instead of by hand in the admin console
            @if (Model.DiscoveryOk && !Model.SupportsDynamicRegistration)
            {
                <text> — </text><span class="pill warn">disabled on this provider</span>
            }
        </div>
    </div>
</div>

@if (Model.DiscoveryOk)
{
    <h2>What the provider advertises</h2>
    <div class="card">
        <div class="kv">
            <div>issuer</div><div><code>@Model.Issuer</code></div>
            <div>authorization_endpoint</div><div><code>@Model.AuthorizationEndpoint</code></div>
            <div>token_endpoint</div><div><code>@Model.TokenEndpoint</code></div>
            <div>userinfo_endpoint</div><div><code>@Model.UserInfoEndpoint</code></div>
            <div>end_session_endpoint</div><div><code>@Model.EndSessionEndpoint</code></div>
            <div>jwks_uri</div><div><code>@Model.JwksUri</code></div>
            <div>scopes_supported</div><div><code>@string.Join(" ", Model.ScopesSupported)</code></div>
        </div>
        <div class="note">
            None of these appear in this application's configuration. They are discovered at
            startup and refreshed periodically, which is what makes signing-key rotation invisible
            to the client and lets the same code point at any compliant provider.
        </div>
        <p style="margin-bottom:0">
            The provider also generates a per-client setup page at
            <code>@Model.IntegrationPageUrl</code> (sign in to the tenant first).
        </p>
    </div>
}
