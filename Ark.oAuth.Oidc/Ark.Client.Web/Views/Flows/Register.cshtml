<script>
    // View/Hide for the pasted machine secret, and the hand-off into whichever form is
    // submitted. It never leaves the page except in this app's own form posts.
    (function () {
        var input = document.getElementById("machine-secret");
        var button = document.getElementById("machine-secret-view");
        if (!input || !button) return;
        button.addEventListener("click", function () {
            var show = input.type === "password";
            input.type = show ? "text" : "password";
            button.textContent = show ? "Hide" : "View";
        });
        document.querySelectorAll("form[data-carry]").forEach(function (form) {
            form.addEventListener("submit", function () {
                var carry = form.querySelector("input.carry-secret");
                if (carry) carry.value = input.value;
            });
        });
    })();
</script>
