@model RegisterModel
@{
    ViewData["Title"] = "Dynamic registration";

    var reg = Model.Registration;
    var target = Model.TargetClient;
    // Every later step is written for one client: the one just registered, otherwise the page's
    // target — this app's own client id unless another was registered.
    var registeredNow = reg?.Succeeded == true ? reg.ClientId : null;
    var clientIdShown = registeredNow ?? Model.TargetClientId;
    var isCurrentApp = string.Equals(clientIdShown, Model.AppClientId, StringComparison.Ordinal);
    var targetExists = registeredNow != null || Model.TargetLookup == "found";
    var newIsConfidential = registeredNow != null ? !string.IsNullOrEmpty(reg!.ClientSecret) : target?.IsConfidential == true;
    // What the IdP said about the machine secret — see BuildRegisterModelAsync. "Configured" alone
    // only meant a value was present, which a recreated IdP database silently invalidates.
    var secretWorks = Model.MachineSecretStatus == "works";
    var secretSource = Model.MachineSecretPasted ? "pasted on this page" : "sample:Machine:ClientSecret";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var signedInAs = User.FindFirst("name")?.Value ?? User.FindFirst("email")?.Value ?? "a user";

    // Registering this app's own client id leaves nothing to configure, unless the kind of client
    // registered (public or confidential) differs from what this app is set up as.
    var commands = new List<string>();
    if (!isCurrentApp)
        commands.Add($"dotnet user-secrets set \"ark_oauth_client:ClientId\" \"{clientIdShown}\" --project Ark.Client.Web");
    if (newIsConfidential && (registeredNow != null || !Model.AppIsConfidential))
        commands.Add("dotnet user-secrets set \"ark_oauth_client:ClientSecret\" \"<client_secret from step 2>\" --project Ark.Client.Web");
    else if (!newIsConfidential && Model.AppIsConfidential)
    {
        commands.Add("# a public client must not send a secret, and this app has one configured");
        commands.Add("dotnet user-secrets remove \"ark_oauth_client:ClientSecret\" --project Ark.Client.Web");
    }
    var switchCommands = string.Join("\n", commands);
}

@* State the page's forms pass along, since each post re-renders the whole page. The secret and
   the registration access token are echoed into this no-store page and kept nowhere else. *@
@functions {
    void CarryFields(bool includeTarget, bool includeManage)
    {
        <input type="hidden" name="MachineSecret" class="carry-secret" value="@Model.MachineSecret" />
        if (includeTarget)
        {
            <input type="hidden" name="TargetClientId" value="@(Model.Registration?.Succeeded == true ? Model.Registration.ClientId : Model.TargetClientId)" />
        }
        if (includeManage)
        {
            <input type="hidden" name="ManageClientId" value="@Model.ManageClientId" />
            <input type="hidden" name="ManageAccessToken" value="@Model.ManageAccessToken" />
        }
    }
}

<style>
