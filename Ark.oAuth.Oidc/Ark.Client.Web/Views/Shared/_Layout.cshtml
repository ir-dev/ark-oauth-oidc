@*
    No third-party CSS or scripts. Styles and the small helper script are local files under
    wwwroot, so the app runs offline and under a strict `'self'` Content-Security-Policy, matching
    the sign-in and consent pages it redirects to.
*@
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var path = (Context.Request.Path.Value ?? "/").TrimEnd('/').ToLowerInvariant();
    string Active(string href) =>
        (href == "/" ? path is "" or "/home" or "/home/index" : path.StartsWith(href)) ? "active" : "";

    var authority = (Config["ark_oauth_client:Authority"] ?? "").TrimEnd('/');
    var adminConsole = authority.Length > 0 ? authority + "/admin" : "";   // {BaseUrl}/{TenantId}/admin
    var signedIn = User.Identity?.IsAuthenticated == true;
    var who = User.FindFirst("name")?.Value ?? User.FindFirst("email")?.Value ?? "signed in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Ark client sample</title>
    <link rel="icon" type="image/png" href="~/img/ark-shield-64.png" />
    <meta name="theme-color" content="#030c23" />
    <link rel="stylesheet" href="~/css/sample.css" asp-append-version="true" />
</head>
<body>
    <header class="nav">
        <div class="nav-inner">
            <a class="brand" href="/">
                <img src="~/img/ark-shield-64.png" alt="" width="30" height="30" />
                <b>Ark client sample</b>
                <small>reference app</small>
            </a>
            <nav class="sx-menu" aria-label="Sample pages">
                <a class="@Active("/")" href="/">Setup guide</a>
                <span class="sx-sep" aria-hidden="true"></span>
                <a class="@Active("/home/secure")" href="/home/secure" title="A page behind [Authorize]">Protected</a>
                <a class="@Active("/home/profile")" href="/home/profile" title="Claims and tokens">Profile</a>
                <a class="@Active("/home/roles")" href="/home/roles" title="Role-based authorization from Ark claims">Roles</a>
                <a class="@Active("/home/downstream")" href="/home/downstream" title="Call an API with the access token">API call</a>
                <span class="sx-sep" aria-hidden="true"></span>
                <a class="@Active("/flows/spa")" href="/flows/spa" title="Authorization code + PKCE in the browser">SPA</a>
                <a class="@Active("/flows/machine")" href="/flows/machine" title="Client credentials">Machine</a>
                <a class="@Active("/flows/register")" href="/flows/register" title="RFC 7591 dynamic registration">Registration</a>
            </nav>
            <span class="spacer"></span>
            <div class="sx-user">
                @if (signedIn)
                {
                    <span class="sx-who" title="@who">
                        <img src="~/img/avatar.png" alt="" width="26" height="26" />
                        <span>@who</span>
                    </span>
                    @* On a shared browser the name above may not belong to the person reading it.
                       This posts to the client library's switch-user endpoint, which drops this
                       application's cookie and challenges with prompt=login, so the provider draws
                       its sign-in form instead of answering from the session it already has. *@
                    <form class="inline" method="post" action="/ark/switch-user">
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button class="btn ghost" type="submit">Not you?</button>
                    </form>
                    <form class="inline" method="post" action="/account/logout">
                        @Html.AntiForgeryToken()
                        <button class="btn ghost" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn" href="/account/login?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Sign in</a>
                }
            </div>
        </div>
    </header>
    <main class="@(ViewData["Wide"] is true ? "wide" : "")">
        @RenderBody()
    </main>
    <footer class="sx-foot">
        <div class="sx-foot-inner">
            <img src="~/img/ark-shield-64.png" alt="" width="28" height="28" />
            <span>Signed in through <b>Ark IdP</b> with <code>Ark.oAuth.Client</code></span>
            @if (!string.IsNullOrEmpty(authority))
            {
                <span>Authority <code>@authority</code></span>
            }
            <span class="spacer"></span>
            @if (!string.IsNullOrEmpty(adminConsole))
            {
                <a href="@adminConsole" target="_blank" rel="noopener">Admin console</a>
                <a href="@authority/.well-known/openid-configuration" target="_blank" rel="noopener">Discovery</a>
            }
            <a href="https://github.com/ir-dev/ark-oauth-oidc/tree/main/Ark.oAuth.Oidc/Ark.oAuth.Client" target="_blank" rel="noopener">Client docs</a>
            <a href="https://github.com/ir-dev/ark-oauth-oidc" target="_blank" rel="noopener">GitHub</a>
        </div>
    </footer>
    <script src="~/js/sample.js" asp-append-version="true" defer></script>
</body>
</html>
