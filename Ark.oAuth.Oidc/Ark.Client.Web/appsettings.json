{
    // -----------------------------------------------------------------------------------------
    // The only section this application needs.
    //
    // Authority is the issuer URL of the Ark server — {BaseUrl}/{TenantId}. The authorize,
    // token, userinfo, jwks and end-session endpoints are read from its discovery document at
    // {Authority}/.well-known/openid-configuration, so there is no public key to paste and
    // nothing to update when a signing key rotates.
    //
    // Authority and ClientId are required. Everything else below is optional and shown at the
    // value this sample uses.
    // -----------------------------------------------------------------------------------------
    "ark_oauth_client": {
        "Authority": "https://localhost:7233/ark_idp",
        "ClientId": "ark_sample_web",

        // Public client (browser-based sign-in, PKCE, no secret). To run this app as a
        // confidential client instead, set token_endpoint_auth_method on the registration to
        // client_secret_post, regenerate the secret in the admin console, and put it here —
        // preferably through user-secrets or an environment variable, never in source control.
        "ClientSecret": null,

        // offline_access is what makes the provider issue a refresh token; without it the
        // session ends when the first access token expires.
        "Scopes": [ "openid", "profile", "email", "offline_access" ],

        // These two produce the redirect URIs that must be registered on the client record:
        //   https://localhost:7255/signin-oidc
        //   https://localhost:7255/signout-callback-oidc
        "CallbackPath": "/signin-oidc",
        "SignedOutCallbackPath": "/signout-callback-oidc",

        "SignedOutRedirectUri": "/",
        "AuthErrorPath": "/", // a failed callback lands here with ?auth_error=...

        "RequireHttpsMetadata": true, // only turn off for local development against plain http
        "CookieName": "ark_sample_web_auth",

        // Ark's per-user-per-client authorization claims (`ark_claims` in the access token) are
        // projected onto this claim type, so [Authorize(Roles = "...")] works against them.
        "RoleClaimType": "role",

        "Domain": "localhost",
        "ExpireMins": 480,

        // ---------------------------------------------------------------------------------
        // Shared browser / wrong account.
        //
        // Single sign-on is a property of the browser, not of the tab. Once one person has
        // signed in to any client, the provider's session cookie answers the authorize request
        // of every other client in that browser — so the next person to open this application
        // is silently signed in as the first, sees "you do not have access", and has no way
        // back: the sign-in link returns to the same session and gives the same answer.
        //
        // RequireArkClaims stops the callback before a cookie is written for an account that
        // has no mapping to this client, and sends the user to AccessDeniedPath, where
        // "Sign in as a different user" challenges the provider with prompt=login.
        // ---------------------------------------------------------------------------------
        "AccountSwitch": {
            "Enabled": true,
            "RequireArkClaims": true,
            "AppDisplayName": "Ark client sample",

            // The built-in page. Point this at one of your own routes and set
            // ServeDefaultPage to false to render it yourself — HttpContext.ArkDeniedAccount()
            // gives your page the account that was refused.
            "AccessDeniedPath": "/ark/no-access",
            "ServeDefaultPage": true,

            "SwitchUserPath": "/ark/switch-user",
            "SignOutPath": "/ark/sign-out",

            // Naming the signed-in account is what makes the page make sense on a shared
            // machine; turn it off if you would rather not print somebody else's address.
            "ShowSignedInAccount": true,
            "AllowFullSignOut": true,

            // false: switching is local — this app drops its cookie and re-prompts, leaving the
            // other applications the previous user has open alone. true: ends the provider
            // session too, signing them out everywhere. Right for a kiosk, heavy for a laptop.
            "EndProviderSessionOnSwitch": false,

            "HomePath": "/"
        }
    },

    // Used only by the sample's own pages — none of this is read by the client library.
    "sample": {
        "RequiredRole": "sample.admin",

        // /flows/spa — a second, separate client: the page runs the authorization code flow with
        // PKCE in the browser. Register it as a public client with this exact redirect URI:
        //   https://localhost:7255/flows/spa
        // and add this origin to ark_oauth_server:Oidc:CorsOrigins on the provider, or the
        // browser blocks the token request before it reaches the server.
        "Spa": {
            "ClientId": "ark_sample_spa",
            // No offline_access: a refresh token in a browser has nowhere safe to live.
            "Scopes": [ "openid", "profile", "email" ]
        },

        // /flows/machine and /flows/register — the machine-to-machine client. The provider seeds
        // "<tenant>_machine" with no secret; generate one with "Regenerate secret" in the admin
        // console and keep it out of source control:
        //   dotnet user-secrets set "sample:Machine:ClientSecret" "<secret>" --project Ark.Client.Web
        "Machine": {
            "ClientId": "ark_idp_machine",
            "ClientSecret": "54d-b59Qtu_2hpN-i46rw0Fp_Q6xFV12RY6wooVVHYM",
            // client.register is what an initial access token needs to create clients through the
            // RFC 7591 registration endpoint.
            "Scopes": [ "client.register" ]
        }
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
