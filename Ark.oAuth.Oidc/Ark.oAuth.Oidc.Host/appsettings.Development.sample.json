{
    // ---------------------------------------------------------------------------------------
    // Template for appsettings.Development.json — the local, gitignored file that holds this
    // machine's real secrets. Copy it, then replace the placeholders:
    //
    //   cp appsettings.Development.sample.json appsettings.Development.json
    //
    // Where each value comes from, first match wins (standard ASP.NET Core layering):
    //
    //   1. environment variables          ark_oauth_server__AdminUser__Password=…
    //   2. appsettings.Development.json   this file's copy (when ASPNETCORE_ENVIRONMENT=Development)
    //   3. appsettings.json               committed, placeholders only
    //
    // Only the keys below need to be here; everything else comes from appsettings.json. A value
    // still left as a "<<placeholder>>" counts as unset, exactly as it does in appsettings.json.
    // ---------------------------------------------------------------------------------------
    "ark_oauth_server": {
        "AdminUser": {
            "Password": "<<set-before-first-run>>" // read only while the database is being created
        },
        "DefaultPw": "<<change-me>>", // initial password given to users created without one
        "EmailConfig": {
            "pw": "<<pw>>"
        }
    }
}
