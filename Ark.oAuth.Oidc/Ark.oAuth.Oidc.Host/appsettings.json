{
    // ---------------------------------------------------------------------------------------
    // The identity provider.
    //
    // Issuer = BaseUrl + BasePath + TenantId. With BasePath empty that is
    // https://localhost:7233/ark_idp, and the discovery document any OIDC client library needs
    // is at https://localhost:7233/ark_idp/.well-known/openid-configuration.
    // ---------------------------------------------------------------------------------------
    "ark_oauth_server": {
        "TenantId": "ark_idp", // a client named "<TenantId>_client" is seeded for the admin console
        "BasePath": "", // set only if the app is hosted under a sub-path (and add UsePathBase to match)
        "BaseUrl": "https://localhost:7233",
        "Provider": "sqlite", // sqlite (default) | mysql | postgres | sqlserver
        "EnableLogTrace": true,
        "CcList": "",
        "BccList": "",
        "UploadPath": "./wwwroot/{0}/",
        // Standard OAuth 2.1 / OIDC behaviour. Every value below is optional and shown at its default.
        "Oidc": {
            "EnableDeviceFlow": true, // RFC 8628, for TVs / CLIs / input-constrained devices
            "EnablePushedAuthorizationRequests": true, // RFC 9126
            "RequirePushedAuthorizationRequests": false, // true refuses plain /authorize requests
            "EnableDynamicRegistration": true, // RFC 7591 - lets callers create clients, see CorsOrigins note below
            "RequireRegistrationAccessToken": true, // keep true unless registration is deliberately public

            // Browser origins allowed to call /oauth2/token, /oauth2/userinfo, discovery and JWKS
            // with fetch. Only single-page applications need this - a server-side client never
            // makes a cross-origin call. Exact origins only; there is no wildcard, because these
            // endpoints hand out tokens.
            //
            // https://localhost:7255 is the Ark.Client.Web sample, whose SPA page runs the
            // authorization code + PKCE flow entirely in the browser.
            "CorsOrigins": [ "https://localhost:7255" ],
            "AlwaysRequireConsent": false, // true forces the consent screen even for first-party clients
            "SessionLifetimeMinutes": 480,
            "MaxFailedSignIns": 10, // 0 disables lockout
            "LockoutMinutes": 15,
            "DeviceCodeLifetimeSeconds": 600,
            "DevicePollIntervalSeconds": 5,
            "ParLifetimeSeconds": 90
        },
        "DefaultPw": "<<change-me>>", // initial password given to users created without one
        "UserPasswordMode": "admin_managed", // admin_managed | email_based | auto (legacy behaviour)

        // The administrator account, created once, when the database is first built.
        //
        // Password is required and has no default — the server used to compile in "admin" /
        // "admin", which meant every deployment shipped with the same credentials on the account
        // that administers every tenant. A value left as a "<<placeholder>>" counts as unset, and
        // seeding stops with a message rather than using it. Keep the real value out of this file:
        //
        //   dotnet user-secrets set "ark_oauth_server:AdminUser:Password" "…"   (development)
        //   ark_oauth_server__AdminUser__Password=…                             (environment)
        //
        // Changing any of this afterwards does nothing; the account already exists. Use the console.
        "AdminUser": {
            "Username": "admin", // the login identifier; need not be an email address
            "Password": "<<set-before-first-run>>",
            "Name": "Admin User"
        },

        // The v2 admin console, served from the server package at /{tenant}/admin.
        "Admin": {
            // The console's session is this host's authentication cookie, so its Sign out link has
            // to hit a route in this host that can drop it. Left empty it falls back to the
            // tenant's end_session_endpoint, which ends the IdP session but not the local one.
            "SignOutUrl": "/Home/SignOutAll"
        },
        "EmailConfig": {
            "email": "ark.idp@immanuel.co",
            "pw": "<<pw>>",
            "from": "ark.idp@immanuel.co",
            "display": "Ark (IdP)",
            "subject": "ARK (IdP): ", // subject prefix
            "smtp": "webmail.immanuel.co",
            "port": "25",
            "host_logo": "https://ark-oidc-server.immanuel.co/img/ark_oidc_logo_2.png",
            "client_logo": "https://ark-oidc-server.immanuel.co/img/ark_logo_1.png",
            // {0} = tenant_id, {1} = the user's one-time ref_uid
            "activation_link": "https://localhost:7233/oauth/{0}/v1/password/reset/{1}",
            "host_company_name": "ARK-RAPID",
            "terms_url": "https://ark-oidc-server.immanuel.co",
            "privacy_policy_url": "https://ark-oidc-server.immanuel.co",
            "host_website_url": "https://ark-oidc-server.immanuel.co",
            "client_website_url": "https://ark-oidc-server.immanuel.co",
            "host_company_display": "ARK (IdP) - Identity Provider"
        }
    },

    // ---------------------------------------------------------------------------------------
    // The admin console, as a client of the server above.
    //
    // Authority is the only address that has to be kept in step: the authorize, token, userinfo,
    // jwks and end-session endpoints are all read from its discovery document. There is no
    // rsaPublic to paste, no issuer/audience to mirror and no per-tenant key table - all of
    // which the v1 configuration required and which went stale the moment a key rotated.
    // ---------------------------------------------------------------------------------------
    "ark_oauth_client": {
        "Authority": "https://localhost:7233/ark_idp",
        "ClientId": "ark_idp_client",
        "ClientSecret": null, // the console runs in a browser, so it is a public client + PKCE
        "Scopes": [ "openid", "profile", "email", "offline_access" ],
        "CallbackPath": "/signin-oidc",
        "SignedOutCallbackPath": "/signout-callback-oidc",
        "SignedOutRedirectUri": "/",
        "AuthErrorPath": "/", // failed callbacks land here with ?auth_error=...
        "RequireHttpsMetadata": true, // only turn off for local development against plain http
        "CookieName": "ark_idp_auth",
        "RoleClaimType": "role", // ark_claims from the access token are projected onto this
        "TenantId": "ark_idp",
        "Domain": "localhost",
        "ExpireMins": 480
    },

    "ConnectionStrings": {
        "ArkAuthConnection": "Data Source=./data/ark_idp.db"
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
