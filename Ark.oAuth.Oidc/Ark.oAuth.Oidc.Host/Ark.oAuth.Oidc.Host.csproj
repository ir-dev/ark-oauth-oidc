<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ark.oAuth.Oidc.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ark.oAuth.Client\Ark.oAuth.Client.csproj" />
    <ProjectReference Include="..\Ark.oAuth.Oidc\Ark.oAuth.Oidc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local secrets and their template: never part of a published build. -->
    <Content Update="appsettings.Development.json;appsettings.Development.sample.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
