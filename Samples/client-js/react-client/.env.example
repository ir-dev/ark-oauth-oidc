# Copy to .env.local (git-ignored) and restart `npm run dev`.
# These are the only two settings. Endpoints and signing keys come from the IdP's discovery document.
# Neither value is a secret: a browser app is a public client and has no client secret at all.

# The issuer, {BaseUrl}/{TenantId}. The QuickStart IdP with the wizard values from the guide:
VITE_ARK_AUTHORITY=https://localhost:7300/ark_idp

# The client_id you registered for this app (step 3 of the guide).
VITE_ARK_CLIENT_ID=team-library
