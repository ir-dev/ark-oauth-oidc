{
  // Deliberately no ark_oauth_server section: the agent (or the wizard) collects it on first run
  // and the identity server writes it to ark-idp-data/settings.json.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The onboarding agent. Nothing here is required: with Provider "none" it runs in guided mode.
  // Credentials and the caller's identity belong in user secrets or the environment, never in
  // this file: this repository is public.
  "ark_onboarding_agent": {
    "AgentName": "Ark Pilot",
    "GreetAtRoot": true,
    "LookForDatabases": true,
    "Llm": {
      "Provider": "none"
    }
  }
}
